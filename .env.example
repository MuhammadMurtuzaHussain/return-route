# Where the server's Gemma runs: "ollama" (local, private — default) or "google" (Google AI Studio, for the hosted demo).
# The phone tier needs neither: it runs Gemma 4 E2B in the browser.
MODEL_PROVIDER=ollama

# Local Gemma via Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=gemma4:e4b

# Hosted Gemma via Google AI Studio (free tier) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Gemma on the phone (WebGPU, transformers.js)
NEXT_PUBLIC_EDGE_MODEL=onnx-community/gemma-4-E2B-it-ONNX

# Optional services. Each one is off until its variable is set.
# Shared cache (Render Key Value / any Redis). Without it, a per-process cache is used.
# REDIS_URL=redis://localhost:6379
# Sentry: traces of every plan and Gemma call, and an issue whenever the guard overrules Gemma.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SerpApi: today's events in town (matches, gigs, markets) boost nearby stops.
# SERPAPI_KEY=

# Optional overrides
# OVERPASS_URLS=https://z.overpass-api.de/api/interpreter,https://overpass-api.de/api/interpreter
# VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# PREFER_LIVE_OSM=1
